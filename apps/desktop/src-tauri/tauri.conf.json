{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Seabell",
  "version": "0.3.1",
  "identifier": "com.damkandev.seabell",
  "build": {
    "beforeDevCommand": "pnpm --filter @seabell/web dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm --filter @seabell/web build",
    "frontendDist": "../../web/out"
  },
  "app": {
    "windows": [
      {
        "title": "Seabell",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 22
        },
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "mimeType": "application/pdf",
        "name": "Documento PDF",
        "role": "Viewer"
      }
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQwRjc0M0VCMTRGM0M3QkIKUldTN3gvTVU2MFAzMEtIOUNZRWpmRjNKWGQ5UGdHUFAvUlFuTHlyTi9lbzg5NDV6akdXYTA0V2gK",
      "endpoints": [
        "https://github.com/damkandev/seabell/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
